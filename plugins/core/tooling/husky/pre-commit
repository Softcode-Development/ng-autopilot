#!/usr/bin/env sh
# Golden pre-commit: lint + format staged files, then type-check.
# Generated by sync — pack steps are appended below the marker; project steps go in .husky/pre-commit.local.
set -e

echo "[hook:pre-commit] lint-staged…"
__EXEC__ lint-staged

echo "[hook:pre-commit] typecheck…"
__TYPECHECK__

# >>> golden pack steps
# <<< golden pack steps

if [ -f .husky/pre-commit.local ]; then sh .husky/pre-commit.local; fi
