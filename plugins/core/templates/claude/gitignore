# Synced to {project}/.claude/.gitignore.

# Flag files that let a guarded flow edit a protected path. Runtime only.
/.flags/

# Review reports are per-run output. Findings that matter go into the
# change's worklog or get fixed; the reports themselves are not history.
# A report another doc must link to (gate evidence) moves to docs/{area}/reviews/.
/reviews/*.md
!/reviews/.gitkeep

# Run output agents write during a delivery: gate output, screenshots, logs,
# coverage dumps. Kept inside the repo so nothing lands elsewhere on disk;
# /autopilot:cleanup empties it.
/tmp/

# The owner's browser sign-in (cookies, local storage) that agents browse with —
# saved by tools/autopilot/browser/sign-in.mjs. Kept out of /tmp/ so cleanup leaves it.
/browser/

# Personal settings and local-only notes (credentials for the visual gate, etc.).
/settings.local.json
*.local.md
